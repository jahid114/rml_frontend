# Caddy configuration for refugeemigrationlab.org
#
# Host: 195.35.23.28 (Caddy). The topology is:
#
#     Caddy :80  -> 308 redirect to https
#     Caddy :443 -> reverse_proxy -> nginx (serves the static Vite build)
#     api.refugeemigrationlab.org -> reverse_proxy -> Hono API
#
# nginx owns the static files and the SPA fallback — see deploy/nginx.conf.
# Caddy must NOT try to serve the files itself: the root path lives on the
# nginx side and is not known here.
#
# Merge the blocks below into /etc/caddy/Caddyfile, then:
#     caddy validate --config /etc/caddy/Caddyfile
#     systemctl reload caddy

{
	email admin@refugeemigrationlab.org
}

# ---------------------------------------------------------------------------
# www -> apex (301 permanent).
#
# The apex is the canonical host used for canonical tags, og:url and the
# sitemap. www is a CNAME to the apex; without this block it answers with
# "503 Service Unavailable" and its TLS handshake fails.
#
# `permanent` = 308. It preserves the request method and is an explicit
# "this is the new home" signal to search engines.
# ---------------------------------------------------------------------------
www.refugeemigrationlab.org {
	redir https://refugeemigrationlab.org{uri} permanent
}

# ---------------------------------------------------------------------------
# Public site (static SPA served by nginx).
#
# The SPA fallback (`try_files $uri $uri/ /index.html`) lives in the nginx
# vhost — deploy/nginx.conf — because nginx is what actually serves the
# files. Do not add `root`/`file_server` here: the deploy path is not
# visible to Caddy and a wrong root would 404 the whole site.
# ---------------------------------------------------------------------------
refugeemigrationlab.org {
	reverse_proxy 127.0.0.1:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# ---------------------------------------------------------------------------
# api.refugeemigrationlab.org
#
# Leave the existing block untouched — it is currently serving the Hono API
# correctly over HTTPS. The frontend bundle calls this origin, so it MUST
# stay on https:// (an http:// API would be blocked as mixed content by
# browsers).
#
# KEEP AS-IS, e.g.:
#
# api.refugeemigrationlab.org {
#     reverse_proxy <existing-upstream> {
#         header_up Host {host}
#         header_up X-Real-IP {remote_host}
#         header_up X-Forwarded-Proto {scheme}
#     }
# }
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# rml-api.shikhonmate.com — currently BROKEN, no longer used by the frontend.
#
# Its TLS handshake fails and plain HTTP answers "503 Service Unavailable",
# so it points at a dead upstream. The frontend uses
# https://api.refugeemigrationlab.org instead.
#
# Either fix the upstream or drop this host entirely. If it is dropped,
# remove the DNS A record for rml-api.shikhonmate.com as well, otherwise it
# keeps resolving and answering 503 to anyone who tries it.
#
# rml-api.shikhonmate.com {
#     reverse_proxy <correct-upstream>
# }
# ---------------------------------------------------------------------------
