# Copy to .env and fill in. Vite bakes VITE_* at dev/build start time.
# URL of the Hono API (backend/). Local dev default: http://localhost:3000.
# For production builds, set this to the deployed backend URL before building.
VITE_API_URL=https://api.refugeemigrationlab.org

# Canonical origin of the public site. Baked into canonical/og/sitemap URLs.
# No trailing slash.
VITE_SITE_URL=https://refugeemigrationlab.org
